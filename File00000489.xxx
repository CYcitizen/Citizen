endfunction
function YB takes item CC returns integer
local integer CH=GetItemCharges(CC)
if CH==0 then
set CH=1
endif
return CH
endfunction
function YC takes nothing returns nothing
local integer CK=0
local integer B5=LoadInteger(BO,StringHash("YDWEStringFormula."+I2S(Bq)),StringHash(I2S(GetItemTypeId(GetManipulatedItem()))))
local integer B8=StringLength(B6[B5])/B7[B5]
local integer CJ=0
local integer CN=0
local integer CE=0
local integer CR=0
local integer Bj=0
local integer CT=0
local boolean CI=false
local item CC=null
local item B9=GetManipulatedItem()
local unit CB=GetTriggerUnit()
local item array CD
local integer array CF
local integer array CG
local integer array CQ
set Bj=0
loop
exitwhen Bj==6
set CC=UnitItemInSlot(CB,Bj)
if CC!=null then
set CD[CE]=CC
set CF[CE]=GetItemTypeId(CC)
set CG[CE]=YB(CC)
if CC==B9 then
set CI=true
endif
set CE=CE+1
endif
set Bj=Bj+1
set CC=null
endloop
if CI==false then
set CD[CE]=B9
set CF[CE]=GetItemTypeId(B9)
set CG[CE]=1
set CE=CE+1
endif
loop
exitwhen CJ==B8
set CK=Xw(B5,CJ)
set CN=StringLength(CO[CK])/CP[CK]-1
set Bj=0
loop
exitwhen Bj==CE
set CQ[Bj]=CG[Bj]
set Bj=Bj+1
endloop
set Bj=0
loop
set CR=CS[X1(CK,Bj)]
exitwhen Bj==CN
set CT=0
loop
exitwhen CT==CE
if CF[CT]==CR and CQ[CT]>0 then
set CQ[CT]=CQ[CT]-1
exitwhen true
endif
set CT=CT+1
endloop
exitwhen CT==CE
set Bj=Bj+1
endloop
if Bj==CN then
if GetRandomInt(0,99)<CU[CK] then
if CV[CK]!=null then
call DestroyEffect(AddSpecialEffectTarget(CV[CK],CB,"origin"))
endif
if CW[CK]!=null then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,30,CW[CK])
endif
set Bj=0
loop
exitwhen Bj==CE
if CQ[Bj]>0 and GetItemCharges(CD[Bj])>0 then
call SetItemCharges(CD[Bj],CQ[Bj])
elseif CQ[Bj]==0 then
call RemoveItem(CD[Bj])
endif
set Bj=Bj+1
endloop
set CC=CreateItem(CR,GetUnitX(CB),GetUnitY(CB))
if GetItemCharges(CC)>0 then
call SetItemCharges(CC,1)
set Bj=0
loop
exitwhen Bj==CE
if CF[Bj]==CR then
call RemoveItem(CD[Bj])
call SetItemCharges(CC,CQ[Bj]+1)
endif
set Bj=Bj+1
endloop
endif
call UnitAddItem(CB,CC)
set CX=CC
call Xl()
elseif Ca[CK] then
set Bj=0
loop
exitwhen Bj==CE
if CQ[Bj]>0 and GetItemCharges(CD[Bj])>0 then
call SetItemCharges(CD[Bj],CQ[Bj])
elseif CQ[Bj]==0 then
call RemoveItem(CD[Bj])
endif
set Bj=Bj+1
endloop
endif
set CC=null
exitwhen true
endif
set CJ=CJ+1
endloop
if CI==false then
call RemoveItem(B9)
endif
set Bj=0
loop
exitwhen Bj==CE
set CD[Bj]=null
set Bj=Bj+1
endloop
set B9=null
set CB=null
set CC=null
endfunction
function YD takes nothing returns nothing
local filterfunc B4=Filter(function X8)
local trigger B3=CreateTrigger()
local integer Bj=0
loop
exitwhen Bj>15
call TriggerRegisterPlayerUnitEvent(B3,Player(Bj),EVENT_PLAYER_UNIT_PICKUP_ITEM,B4)
set Bj=Bj+1
endloop
call TriggerAddCondition(B3,Condition(function X9))
call TriggerAddAction(B3,function YC)
call DestroyFilter(B4)
set B4=null
set B3=null
endfunction
function YE takes integer Jt,integer Ju,integer Jv,integer Jw,integer Jx,integer Jy,integer Jz,integer J0,integer J1,integer J2,integer J3,integer J4,integer J5 returns nothing
local integer KF=X6(Jt,Ju,Jv,Jw,Jx,Jy,Jz,J0,J1,J2,J3,J4,0,0)
local integer B5=Xx(J5)
local string B4=I2S(KE)+X7(KF)
local string KO=""
local integer Bj=0
set KK=X2(KE,B4,B5)
if KK>0 then
set KO=Xt(KK,KE)
set Bj=0
loop
exitwhen Bj>KC[KF]
call Xy(Bl[Bm[KF]+Bj],KO)
set Bj=Bj+1
endloop
call Xy(B5,KO)
endif
call X5(KF)
set B4=""
set KO=""
endfunction
function YF takes unit MP,unit MQ,real MR,real MS,real Ct,integer MT,integer MU,integer MV,integer MW returns nothing
local unit MX=CreateUnit(GetOwningPlayer(MP),MT,MR,MS,GetUnitFacing(MP))
call UnitApplyTimedLife(MX,$42487765,1.)
call UnitAddAbility(MX,MU)
call SetUnitAbilityLevel(MX,MU,MV)
call SetUnitFlyHeight(MX,Ct,0.)
call IssueTargetOrderById(MX,MW,MQ)
set MX=null
endfunction
function YH takes unit BL,unit CB returns boolean
return IsUnitType(BL,UNIT_TYPE_MAGIC_IMMUNE)==false and IsUnitType(BL,UNIT_TYPE_RESISTANT)==false and IsUnitType(BL,UNIT_TYPE_SLEEPING)==false and GetUnitState(BL,UNIT_STATE_LIFE)>.405 and IsUnitType(BL,UNIT_TYPE_STRUCTURE)==false and IsUnitIllusion(BL)==false and IsUnitHidden(BL)==false and IsUnitEnemy(BL,GetOwningPlayer(CB)) and IsUnitVisible(BL,GetOwningPlayer(CB))
endfunction
function YI takes nothing returns boolean
local integer Cd=GetDestructableTypeId(GetFilterDestructable())
return Cd==$4C546C74 or Cd==$41547472 or Cd==$42547477 or Cd==$4B547477 or Cd==$59546674 or Cd==$4A546374 or Cd==$59547374 or Cd==$59546374 or Cd==$59547774 or Cd==$4A547477 or Cd==$44547368 or Cd==$46547477 or Cd==$43547472 or Cd==$49547477 or Cd==$4E547477 or Cd==$4F547477 or Cd==$5A547477 or Cd==$57547374 or Cd==$47547368 or Cd==$56546C74 or Cd==$57547477 or Cd==$41547463 or Cd==$42547463 or Cd==$43547463 or Cd==$49547463 or Cd==$4E547463 or Cd==$5A547463
endfunction
function YJ takes nothing returns boolean
local unit BL=GetFilterUnit()
local integer MK=ML
if not IsUnitInGroup(BL,BT[MK]) and MG[MK]!=0 and YH(BL,BZ[MK]) then
call UnitDamageTarget(BZ[MK],BL,Bb[MK],true,true,MM,MN,MO)
call DestroyEffect(AddSpecialEffectTarget(Be[MK],BL,Bh[MK]))
if Bc[MK]>$30303030 and Bc[MK]!=null and Bd[MK]>0 and Bd[MK]!=null then
call YF(BZ[MK],BL,L8[BX[MK]],L9[BX[MK]],GetUnitFlyHeight(BR[MK]),MY[MK],Bc[MK],MZ[MK],Bd[MK])
endif
if not ME[MK] then
set MG[MK]=0
endif
set Ba[MK]=BL
set BL=null
return true
endif
set BL=null
return false
endfunction
function YK takes nothing returns nothing
local destructable MK=GetEnumDestructable()
if GetWidgetLife(MK)>.405 then
call KillDestructable(MK)
endif
set MK=null
endfunction
function YO takes integer BP,real HV returns nothing
set L8[BX[BP]]=HV
call SetUnitX(BR[BP],HV)
endfunction
function YP takes integer BP,real HV returns nothing
set L9[BX[BP]]=HV
call SetUnitY(BR[BP],HV)
endfunction
function YW takes nothing returns nothing
local integer BP=LoadInteger(BO,StringHash("YDWETimerPattern."),StringHash(I2S(GetHandleId(GetExpiredTimer()))))
local real MI=GetUnitX(BR[BP])+MB[BP]*L8[BY[BP]]
local real MJ=GetUnitY(BR[BP])+MB[BP]*L9[BY[BP]]
if MF[BP]==false then
if IsTerrainPathable(MI,MJ,PATHING_TYPE_WALKABILITY) then
set MG[BP]=0
else
call YO(BP,MI)
call YP(BP,MJ)
endif
else
call YO(BP,MI)
call YP(BP,MJ)
endif
if MH[BP]==0 then
if GetUnitFlyHeight(BR[BP])<5. then
if IsTerrainPathable(L8[BX[BP]],L9[BX[BP]],PATHING_TYPE_FLOATABILITY) then
call DestroyEffect(AddSpecialEffect(Bf[BP],L8[BX[BP]],L9[BX[BP]]))
else
call DestroyEffect(AddSpecialEffect(Bg[BP],L8[BX[BP]],L9[BX[BP]]))
endif
endif
endif
set MH[BP]=MH[BP]+1
if MH[BP]==2 then
set MH[BP]=0
endif
if MD[BP] then
call MoveRectTo(Cb,L8[BX[BP]],L9[BX[BP]])
call EnumDestructablesInRect(Cb,Cc,function YK)
endif
if Bb[BP]>0. then
set ML=BP
call GroupEnumUnitsInRange(BT[BP],L8[BX[BP]],L9[BX[BP]],120.,Condition(function YJ))
endif
set MB[BP]=MB[BP]-MC[BP]
if MB[BP]<=0. or RMinBJ(RMaxBJ(L8[BX[BP]]*1.,By),B0)!=L8[BX[BP]] or RMinBJ(RMaxBJ(L9[BX[BP]]*1.,Bz),B1)!=L9[BX[BP]] then
set MG[BP]=0
endif
if MG[BP]==0 then
call SetUnitFlyHeight(BR[BP],GetUnitDefaultFlyHeight(BR[BP]),200.)
call SetUnitTimeScale(BR[BP],1)
call W0(BR[BP],6)
call S4(BP)
endif
endfunction
function YX takes unit Lv,unit Lw,real Lx,real Ly,real Lz,real L0,real Lo,boolean Lp,boolean Lq,boolean Lr,string Ls,string L1,string L2 returns integer
local integer BP=TB()
set BW[BP]=S5()
set BX[BP]=S5()
set BY[BP]=S5()
set L8[BY[BP]]=Cos(Lx)
set L9[BY[BP]]=Sin(Lx)
set MB[BP]=2*Ly*L0/Lz
set MC[BP]=MB[BP]*L0/Lz
set L8[BX[BP]]=GetUnitX(Lw)
set L9[BX[BP]]=GetUnitY(Lw)
set BZ[BP]=Lv
set BR[BP]=Lw
set Bb[BP]=Lo
set MD[BP]=Lp
set ME[BP]=Lq
set MF[BP]=Lr
set Bf[BP]=L1
set Bg[BP]=L2
set MG[BP]=1
set MH[BP]=0
set BT[BP]=CreateGroup()
set BS[BP]=CreateTimer()
call TimerStart(BS[BP],L0,true,function YW)
call SaveInteger(BO,StringHash("YDWETimerPattern."),StringHash(I2S(GetHandleId(BS[BP]))),BP)
return BP
endfunction
function Ya takes unit BL,real Lk,real Ll,real Lm,real Ln,real Lo,boolean Lp,boolean Lq,boolean Lr,string Ls,string Lt,string Lu returns nothing
if BL==null then
return
endif
call YX(BL,BL,Deg2Rad(Lk),RMaxBJ(Ll,0),RMaxBJ(Lm,0),RMaxBJ(Ln,0),Lo,Lp,Lq,Lr,Ls,Lt,Lu)
endfunction
function Yb takes nothing returns nothing
set Cb=Rect(-120.,-120.,120.,120.)
set Cc=Filter(function YI)
endfunction
function Yc takes nothing returns integer
local integer Ct=Cj
if Cj<0 then
if Ck>=8000 then
return 8100
else
set Ck=Ck+1
return Ck
endif
endif
set Cj=Cl[Ct]
return Ct
endfunction
function Yd takes integer Cw returns nothing
set Cl[Cw]=Cj
set Cj=Cw
endfunction
function Ye takes real Lz,trigger Sl returns integer
local integer Cw=Yc()
local integer Ct=Ch
local integer B3=R2I(100.*Lz)+Cg
local integer BK
set Cv[Cw]=Sl
set Cu[Cw]=B3
loop
set BK=Ci[Ct]
if BK<0 or Cu[BK]>=B3 then
set Ci[Ct]=Cw
set Ci[Cw]=BK
return Cw
endif
set Ct=BK
endloop
return Cw
endfunction
function Yh takes nothing returns nothing
call RemoveUnit(LoadUnitHandle(BO,Cf,Cs))
call RemoveSavedHandle(BO,Cf,Cs)
endfunction
function Yj takes nothing returns nothing
call DestroyTimer(LoadTimerHandle(BO,Cf,Cs))
call RemoveSavedHandle(BO,Cf,Cs)
endfunction
function Yl takes nothing returns nothing
call RemoveItem(LoadItemHandle(BO,Cf,Cs))
call RemoveSavedHandle(BO,Cf,Cs)
endfunction
function Yn takes nothing returns nothing
call DestroyEffect(LoadEffectHandle(BO,Cf,Cs))
call RemoveSavedHandle(BO,Cf,Cs)
endfunction
function Yp takes nothing returns nothing
call DestroyLightning(LoadLightningHandle(BO,Cf,Cs))
call RemoveSavedHandle(BO,Cf,Cs)
endfunction
function Yq takes real Lz,lightning Sk returns nothing
local integer Bj=Ye(Lz,Cq)
call SaveLightningHandle(BO,Cf,Bj,Sk)
endfunction
function Yr takes nothing returns nothing
call TriggerExecute(LoadTriggerHandle(BO,Cf,Cs))
call RemoveSavedHandle(BO,Cf,Cs)
endfunction
function Yu takes nothing returns nothing
local integer Ct=Ch
loop
set Cs=Ci[Ct]
exitwhen Cs<0 or Cg<Cu[Cs]
call TriggerEvaluate(Cv[Cs])
call Yd(Cs)
set Ci[Ct]=Ci[Cs]
endloop
set Cg=Cg+1
endfunction
function Yv takes nothing returns nothing
set Ce=CreateTimer()
set Cf=GetHandleId(Ce)
set Cg=0
set Ch=0
set Ci[0]=-1
set Cj=1
set Ck=1
set Cl[1]=-1
set Cm=CreateTrigger()
set Cn=CreateTrigger()
set Co=CreateTrigger()
set Cp=CreateTrigger()
set Cq=CreateTrigger()
set Cr=CreateTrigger()
call TriggerAddCondition(Cm,Condition(function Yh))
call TriggerAddCondition(Cn,Condition(function Yj))
call TriggerAddCondition(Co,Condition(function Yl))
call TriggerAddCondition(Cp,Condition(function Yn))
call TriggerAddCondition(Cq,Condition(function Yp))
call TriggerAddCondition(Cr,Condition(function Yr))
call TimerStart(Ce,.01,true,function Yu)
endfunction
