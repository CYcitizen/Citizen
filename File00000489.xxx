call SaveGroupHandle(Bx,GetHandleId(Fd),$43F73514,LoadGroupHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$43F73514))
call TimerStart(Fd,15.,false,function ap)
else
call StartTimerBJ(FO[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],false,45.)
call CreateTimerDialogBJ(FO[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],"|cffffcc00本回合剩余时间|r")
set Io[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)]=bj_lastCreatedTimerDialog
