function ax takes nothing returns nothing
set Hs=CreateTrigger()
call DisableTrigger(Hs)
call TriggerRegisterAnyUnitEventBJ(Hs,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(Hs,Condition(function as))
call TriggerAddAction(Hs,function aw)
endfunction
function ay takes nothing returns boolean
return GetSpellAbilityId()==$41304637
endfunction
function az takes nothing returns nothing
call UB(LoadUnitHandle(Bx,GetHandleId(GetExpiredTimer()),$FE45020D),LoadInteger(Bx,GetHandleId(GetExpiredTimer()),$B0A9479A),1,0.)
call FlushChildHashtable(Bx,GetHandleId(GetExpiredTimer()))
call DestroyTimer(GetExpiredTimer())
endfunction
