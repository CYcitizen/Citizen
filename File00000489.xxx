function ZL takes nothing returns nothing
local integer G1
local integer GD
local integer Fc=LoadInteger(Bx,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set Fc=Fc+3
call SaveInteger(Bx,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,Fc)
call SaveInteger(Bx,GetHandleId(GetTriggeringTrigger()),$ECE825E7,Fc)
set G1=1
loop
exitwhen G1>4
call SaveInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A,G1)
set G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)]=CreateMultiboard()
call MultiboardSetRowCount(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],6)
call MultiboardSetColumnCount(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],3)
call MultiboardSetItemsStyle(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],true,false)
call MultiboardSetTitleText(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],GetPlayerName(F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)])+" 五行数据")
call XY(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],1,1,"|cffffcc00当前回合 Level["+I2S(C5)+"]|r")
call XX(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],1,2,true,true)
call XX(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],1,3,true,true)
call XX(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],3,3,true,false)
call XX(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],1,4,true,true)
call XX(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],1,5,true,true)
call XX(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],1,6,true,true)
call XX(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],1,7,true,true)
call XZ(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],1,0,8.25)
call XZ(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],2,0,3.15)
call XZ(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],3,0,3.15)
call XY(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],2,1,"|cffffcc00等级|r")
