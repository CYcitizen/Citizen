function Sz takes nothing returns integer
local integer BP=Br
if BP!=0 then
set Br=Bs[BP]
else
set Bt=Bt+1
set BP=Bt
endif
if BP>8190 then
return 0
endif
set Bu[BP]=1
set Bs[BP]=-1
return BP
endfunction
function S1 takes nothing returns integer
local integer BP=Sz()
local integer Bv
if BP==0 then
return 0
endif
set Bu[BP]=2
set Bv=BP
return BP
endfunction
function S3 takes nothing returns integer
local integer BP=L3
if BP!=0 then
set L3=L4[BP]
else
set L5=L5+1
set BP=L5
endif
if BP>8190 then
return 0
endif
set L6[BP]=9
set L4[BP]=-1
return BP
endfunction
function S4 takes integer BP returns nothing
if BP==null then
return
elseif L4[BP]!=-1 then
return
endif
set BN=BP
call TriggerEvaluate(BQ[L6[BP]])
set L4[BP]=L3
set L3=BP
endfunction
function S5 takes nothing returns integer
local integer BP=BV
if BP!=0 then
set BV=BU[BP]
else
set L7=L7+1
set BP=L7
endif
if BP>8190 then
return 0
endif
set BU[BP]=-1
return BP
endfunction
function S6 takes integer BP returns nothing
if BP==null then
return
elseif BU[BP]!=-1 then
return
endif
set BU[BP]=BV
set BV=BP
endfunction
function S8 takes nothing returns integer
local integer BP=J8
if BP!=0 then
set J8=J9[BP]
else
set KB=KB+1
set BP=KB
endif
if BP>1022 then
return 0
endif
set Bm[BP]=(BP-1)*8
set Bo[BP]=(BP-1)*8
set KC[BP]=7
set J9[BP]=-1
return BP
endfunction
function TB takes nothing returns integer
local integer BP=S3()
local integer Bv
if BP==0 then
return 0
endif
set L6[BP]=12
set Bv=BP
return BP
endfunction
function Tb takes player HT,string HU,integer HV returns nothing
set HU="I"+HU
call DzAPI_Map_SaveServerValue(HT,HU,I2S(HV))
set HU=null
set HT=null
endfunction
function Tc takes player HT,string HU returns integer
local integer HV
set HU="I"+HU
set HV=S2I(DzAPI_Map_GetServerValue(HT,HU))
set HU=null
set HT=null
return HV
endfunction
function T5 takes nothing returns nothing
set BO=InitHashtable()
set Bx=InitHashtable()
endfunction
function T7 takes unit BL,integer Is,integer LL,integer LM returns integer
return EXGetAbilityDataInteger(EXGetUnitAbility(BL,Is),LL,LM)
endfunction
function T8 takes unit BL,integer Is,integer LL,integer LM returns real
return EXGetAbilityDataReal(EXGetUnitAbility(BL,Is),LL,LM)
endfunction
function UB takes unit BL,integer Is,integer It,real HV returns boolean
return EXSetAbilityState(EXGetUnitAbility(BL,Is),It,HV)
endfunction
function UC takes unit BL,integer Is,integer LL,integer LM,integer HV returns boolean
return EXSetAbilityDataInteger(EXGetUnitAbility(BL,Is),LL,LM,HV)
endfunction
function UD takes unit BL,integer Is,integer LL,integer LM,real HV returns boolean
return EXSetAbilityDataReal(EXGetUnitAbility(BL,Is),LL,LM,HV)
endfunction
function UE takes unit BL,integer Is,integer LL,integer LM,string HV returns boolean
return EXSetAbilityDataString(EXGetUnitAbility(BL,Is),LL,LM,HV)
endfunction
function Wq takes unit Sg,unit Sh returns real
return bj_RADTODEG*Atan2(GetUnitY(Sh)-GetUnitY(Sg),GetUnitX(Sh)-GetUnitX(Sg))
endfunction
function W0 takes unit Ma,integer Cw returns nothing
local integer Bj=0
loop
exitwhen Bj>=Mb
if Mc[Bj]==Cw then
set Md=Ma
if Me[Bj]!=null and TriggerEvaluate(Me[Bj]) and IsTriggerEnabled(Me[Bj]) then
call TriggerExecute(Me[Bj])
endif
endif
set Bj=Bj+1
endloop
endfunction
function XE takes nothing returns boolean
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,30,"|cFF1E90FF当前编辑器版本为： |r|cFF00FF00YDWE 0.0.0.0")
return false
endfunction
function XF takes nothing returns nothing
local trigger B3=CreateTrigger()
local integer Bj=0
loop
