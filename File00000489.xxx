set CV[BP]=null
set CW[BP]=null
set CU[BP]=100
set Ca[BP]=false
call SaveInteger(BO,StringHash("YDWEStringFormula."+I2S(Bw)),StringHash(KM),BP)
set KN=KN+1
return BP
endfunction
function X3 takes nothing returns nothing
set Bw=S1()
