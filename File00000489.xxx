call DisplayTimedTextToPlayer(GetOwningPlayer(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D)),0,0,10.,"攻击伤害："+(I2S(R2I(GetUnitState(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D),ConvertUnitState(20))))+" - "+I2S(R2I(GetUnitState(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D),ConvertUnitState(21))))))
call DisplayTimedTextToPlayer(GetOwningPlayer(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D)),0,0,10.,"攻击强度："+SubStringBJ(R2S(LoadReal(BO,GetHandleId(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D)),$DBDA0540)*100.),1,3)+"%")
call DisplayTimedTextToPlayer(GetOwningPlayer(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D)),0,0,10.,"攻击频率："+SubStringBJ(R2S(LoadReal(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$4A9B284D)),1,4))
call DisplayTimedTextToPlayer(GetOwningPlayer(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D)),0,0,10.,"攻击范围："+I2S(R2I(GetUnitState(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D),ConvertUnitState(22)))))
call DisplayTimedTextToPlayer(GetOwningPlayer(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D)),0,0,10.,"暴击几率："+I2S(LoadInteger(BO,GetHandleId(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D)),$AAB10C18))+"%")
call DisplayTimedTextToPlayer(GetOwningPlayer(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D)),0,0,10.,"暴击伤害："+SubStringBJ(R2S(LoadReal(BO,GetHandleId(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D)),$E6EBA1F1)*100.),1,3)+"%")
