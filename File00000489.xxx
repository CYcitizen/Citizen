call SaveInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$7FDD09C2,R2I(I2R(LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$C01454E2)*FK[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)]*3+300)*LoadReal(BO,GetHandleId(GetOwningPlayer(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D))),$6ABB9464)))
