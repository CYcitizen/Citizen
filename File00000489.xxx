if IsUnitType(GetSpellAbilityUnit(),UNIT_TYPE_PEON)==true then
if GetOwningPlayer(GetSpellAbilityUnit())==F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)] then
if GetPlayerState(F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],PLAYER_STATE_RESOURCE_FOOD_USED)<LoadInteger(BO,GetHandleId(F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)]),$3FD00CC9) then
if RectContainsLoc(D,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(E,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(F,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(G,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(H,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(I,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(J,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(K,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(L,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(M,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(N,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(O,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(P,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(Q,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(R,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(S,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true then
call DoNothing()
exitwhen true
else
call ForceUICancelBJ(F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)])
call IssueImmediateOrder(HO[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],"stop")
call DisplayTextToPlayer(F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],0,0,"【系统提示】不能在此建造。")
call DoNothing()
exitwhen true
endif
else
call ForceUICancelBJ(F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)])
call IssueImmediateOrder(HO[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],"stop")
call DisplayTextToPlayer(F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],0,0,"【系统提示】|cffff0000已达到最大人口。|r")
call DoNothing()
exitwhen true
endif
else
call DoNothing()
endif
else
call ForceUICancelBJ(F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)])
call IssueImmediateOrder(GetSpellAbilityUnit(),"stop")
