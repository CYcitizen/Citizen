function ks takes nothing returns nothing
local integer GD
local timer Fd
local group IT
local unit IU
local integer Fc=LoadInteger(Bx,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set Fc=Fc+3
call SaveInteger(Bx,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,Fc)
call SaveInteger(Bx,GetHandleId(GetTriggeringTrigger()),$ECE825E7,Fc)
call SaveInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$B0A9479A,GetSpellAbilityId())
call SaveUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D,GetTriggerUnit())
set GD=1
loop
exitwhen GD>4
call SaveInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A,GD)
if GetOwningPlayer(GetTriggerUnit())==F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)] then
call SaveLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F,GetSpellTargetLoc())
if RectContainsLoc(D,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(E,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(F,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(G,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(H,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(I,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(J,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(K,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(L,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(M,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(N,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(O,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(P,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(Q,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(R,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true or RectContainsLoc(S,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))==true then
call SaveInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$2970F80D,0)
call SaveGroupHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$3547468F,XS(a,Condition(function kn)))
call ForGroupBJ(LoadGroupHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$3547468F),function kp)
if LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$2970F80D)==0 then
set Fd=CreateTimer()
call SaveUnitHandle(Bx,GetHandleId(Fd),$FE45020D,LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D))
call SaveLocationHandle(Bx,GetHandleId(Fd),$5E83114F,LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))
call TimerStart(Fd,.1,false,function kq)
else
call ForceUICancelBJ(F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)])
call IssueImmediateOrder(GetTriggerUnit(),"stop")
call DisplayTextToPlayer(F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],0,0,"【系统提示】离其他单位过近，请重新选择移动地点。")
call RemoveLocation(LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))
set Fd=CreateTimer()
call SaveInteger(Bx,GetHandleId(Fd),$B0A9479A,LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$B0A9479A))
call SaveUnitHandle(Bx,GetHandleId(Fd),$FE45020D,LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D))
call TimerStart(Fd,.1,false,function kr)
endif
else
call ForceUICancelBJ(F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)])
call IssueImmediateOrder(GetTriggerUnit(),"stop")
call DisplayTextToPlayer(F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],0,0,"【系统提示】不能移动到此处。")
call RemoveLocation(LoadLocationHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$5E83114F))
set Fd=CreateTimer()
call SaveInteger(Bx,GetHandleId(Fd),$B0A9479A,LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$B0A9479A))
call SaveUnitHandle(Bx,GetHandleId(Fd),$FE45020D,LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D))
call TimerStart(Fd,.1,false,function ko)
endif
call DoNothing()
exitwhen true
else
call DoNothing()
endif
