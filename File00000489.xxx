call StartTimerBJ(FO[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],false,180.)
call CreateTimerDialogBJ(FO[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],"|cffffcc00最终回剩余时间|r")
