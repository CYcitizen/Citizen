set Fd=CreateTimer()
call SaveInteger(Bx,GetHandleId(Fd),$BEC6909A,LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A))
call TimerStart(Fd,15.,false,function aj)
