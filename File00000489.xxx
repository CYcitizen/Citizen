call FlushChildHashtable(Bx,GetHandleId(GetTriggeringTrigger()))
call DestroyTrigger(GetTriggeringTrigger())
endfunction
function a1 takes nothing returns nothing
if IsUnitAliveBJ(LoadUnitHandle(Bx,GetHandleId(GetExpiredTimer()),$2B6C7253))==true then
call RemoveUnit(LoadUnitHandle(Bx,GetHandleId(GetExpiredTimer()),$2B6C7253))
if GetPlayerController(F8[LoadInteger(Bx,GetHandleId(GetExpiredTimer()),$BEC6909A)])==MAP_CONTROL_USER and GetPlayerSlotState(F8[LoadInteger(Bx,GetHandleId(GetExpiredTimer()),$BEC6909A)])==PLAYER_SLOT_STATE_PLAYING and IsUnitAliveBJ(HO[LoadInteger(Bx,GetHandleId(GetExpiredTimer()),$BEC6909A)])==true then
call DisplayTextToPlayer(F8[LoadInteger(Bx,GetHandleId(GetExpiredTimer()),$BEC6909A)],0,0,"【系统提示】：|cffff0000挑战失败！！！|r")
else
call DoNothing()
endif
call DestroyTrigger(LoadTriggerHandle(Bx,GetHandleId(GetExpiredTimer()),$6BD5D6E5))
call FlushChildHashtable(Bx,GetHandleId(GetExpiredTimer()))
call DestroyTimer(GetExpiredTimer())
else
call FlushChildHashtable(Bx,GetHandleId(GetExpiredTimer()))
call DestroyTimer(GetExpiredTimer())
endif
endfunction
