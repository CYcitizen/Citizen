if BP==null then
return
elseif J9[BP]!=-1 then
return
endif
call X4(BP)
set J9[BP]=J8
set J8=BP
endfunction
function X6 takes integer Jt,integer Ju,integer Jv,integer Jw,integer Jx,integer Jy,integer Jz,integer J0,integer J1,integer J2,integer J3,integer J4,integer J6,integer J7 returns integer
local integer BP=S8()
set Bl[Bm[BP]+1]=Xx(Jt)
set Bl[Bm[BP]+2]=Xx(Jv)
set Bl[Bm[BP]+3]=Xx(Jx)
set Bl[Bm[BP]+4]=Xx(Jz)
set Bl[Bm[BP]+5]=Xx(J1)
set Bl[Bm[BP]+6]=Xx(J3)
set Bl[Bm[BP]+7]=Xx(J6)
set Bn[Bo[BP]+1]=Ju
set Bn[Bo[BP]+2]=Jw
set Bn[Bo[BP]+3]=Jy
set Bn[Bo[BP]+4]=J0
set Bn[Bo[BP]+5]=J2
set Bn[Bo[BP]+6]=J4
set Bn[Bo[BP]+7]=J7
return BP
endfunction
function X7 takes integer BP returns string
local integer Bj=1
local integer CT
local integer KG
set Bp[BP]=""
loop
exitwhen Bj>KC[BP]
if Bl[Bm[BP]+Bj]==0 or Bn[Bo[BP]+Bj]==0 then
set Bl[Bm[BP]+Bj]=Bl[Bm[BP]+KC[BP]]
set Bn[Bo[BP]+Bj]=Bn[Bo[BP]+KC[BP]]
set KC[BP]=KC[BP]-1
set Bj=Bj-1
else
set CT=Bj+1
loop
exitwhen CT>KC[BP]
if Bl[Bm[BP]+CT]==0 or Bn[Bo[BP]+CT]==0 then
set Bl[Bm[BP]+CT]=Bl[Bm[BP]+KC[BP]]
set Bn[Bo[BP]+CT]=Bn[Bo[BP]+KC[BP]]
set KC[BP]=KC[BP]-1
set CT=CT-1
elseif Bl[Bm[BP]+Bj]>Bl[Bm[BP]+CT] then
set KG=Bl[Bm[BP]+Bj]
set Bl[Bm[BP]+Bj]=Bl[Bm[BP]+CT]
set Bl[Bm[BP]+CT]=KG
set KG=Bn[Bo[BP]+Bj]
set Bn[Bo[BP]+Bj]=Bn[Bo[BP]+CT]
set Bn[Bo[BP]+CT]=KG
elseif Bl[Bm[BP]+Bj]==Bl[Bm[BP]+CT] then
set Bn[Bo[BP]+Bj]=Bn[Bo[BP]+Bj]+Bn[Bo[BP]+CT]
set Bl[Bm[BP]+CT]=0
set CT=CT-1
endif
set CT=CT+1
endloop
set CT=Bn[Bo[BP]+Bj]
loop
exitwhen CT==0
set Bp[BP]=Bp[BP]+Xt(Bl[Bm[BP]+Bj],KE)
set CT=CT-1
endloop
endif
set Bj=Bj+1
endloop
return Bp[BP]
endfunction
