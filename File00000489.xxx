call SaveForceHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$F8057F64,XP(GetOwningPlayer(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D))))
call ClearTextMessagesBJ(LoadForceHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$F8057F64))
