call XY(G2[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],1,1,"|cffffcc00当前回合 Level["+I2S(FK[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)])+"]|r")
