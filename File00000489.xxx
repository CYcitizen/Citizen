function gh takes nothing returns nothing
local integer GD
local integer Fc=LoadInteger(Bx,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set Fc=Fc+3
call SaveInteger(Bx,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,Fc)
call SaveInteger(Bx,GetHandleId(GetTriggeringTrigger()),$ECE825E7,Fc)
call SaveUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D,GetTriggerUnit())
if LoadInteger(BO,GetHandleId(GetOwningPlayer(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D))),$306CBB93)==0 then
if GetPlayerState(GetOwningPlayer(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D)),PLAYER_STATE_RESOURCE_GOLD)>=2000 then
set GD=1
loop
exitwhen GD>4
call SaveInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A,GD)
if GetOwningPlayer(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D))==F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)] then
call SaveInteger(BO,GetHandleId(F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)]),$306CBB93,1)
call SaveItemHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$1769D332,CreateItem($49303044,GetUnitX(HO[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)]),GetUnitY(HO[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)])))
call SaveInteger(BO,GetHandleId(LoadItemHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$1769D332)),$306CBB93,0)
call SaveInteger(BO,GetHandleId(LoadItemHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$1769D332)),$B7279243,0)
call SavePlayerHandle(BO,GetHandleId(LoadItemHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$1769D332)),$A59BB4C6,F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)])
call UnitAddItem(HO[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],LoadItemHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$1769D332))
call SetItemCharges(LoadItemHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$1769D332),LoadInteger(BO,GetHandleId(LoadItemHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$1769D332)),$B7279243))
call SetPlayerStateBJ(F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],PLAYER_STATE_RESOURCE_GOLD)-2000)
call DoNothing()
exitwhen true
else
call DoNothing()
endif
set GD=GD+1
endloop
else
call DisplayTextToPlayer(GetOwningPlayer(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D)),0,0,"【系统提示】：|cffffcc00金币|r|cffff0000不足，无法购买！|r")
