call AdjustPlayerStateBJ(-5000,F8[LoadInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$BEC6909A)],PLAYER_STATE_RESOURCE_GOLD)
call SaveInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$C01454E2,GetRandomInt(1,5))
