call SaveInteger(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$9DA51395,R2I(I2R(LoadInteger(BO,GetHandleId(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$2B6C7253)),$E151D648))*10.*LoadReal(BO,GetHandleId(GetOwningPlayer(LoadUnitHandle(Bx,GetHandleId(GetTriggeringTrigger())*Fc,$FE45020D))),$9DA51395)))
